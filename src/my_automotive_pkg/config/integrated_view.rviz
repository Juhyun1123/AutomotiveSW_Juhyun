Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Ground Grid1
    - /TF Tree1
    - /Custom Vehicle Markers1
    Splitter Ratio: 0.5
  Tree Height: 557
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Ground Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 30
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: true
    Marker Scale: 0.25
    Name: TF Tree
    Show Arrows: true
    Show Axes: true
    Show Names: false
    Tree: {}
    Update Interval: 0
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Custom Vehicle Markers
    Namespaces: {}
    Topic:
      Depth: 10
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /visual_markers
    Value: true
  - Class: rviz_default_plugins/RobotModel
    Name: Vehicle Model
    Enabled: true
    Alpha: 1.0
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
    Visual Enabled: true
    Collision Enabled: false
    Update Interval: 0.0
  - Class: rviz_default_plugins/LaserScan
    Name: LiDAR Scan
    Enabled: true
    Topic:
      Value: /scan
      Depth: 5
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Filter size: 10
    Alpha: 1.0
    Style: Points
    Size (Pixels): 3
    Size (m): 0.03
    Color Transformer: FlatColor
    Color: 255; 255; 0
    Decay Time: 0.0
    Position Transformer: XYZ
    Use Fixed Frame: true
    Value: true
  - Class: rviz_default_plugins/Image
    Name: Front Camera
    Enabled: true
    Topic:
      Value: /camera/image_raw
      Depth: 2
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
    Transport Hint: raw
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18.0
      Focal Point:
        X: 4.5
        Y: 0.0
        Z: 0.5
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.8
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 3.8
Window Geometry:
  Height: 1400
  Width: 2400
  X: 0
  Y: 0
